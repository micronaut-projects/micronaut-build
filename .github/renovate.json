{
  "extends": [
    "config:recommended"
  ],
  "addLabels": ["dependency-upgrade"],
  "schedule": [
    "every weekend"
  ],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 20,
  "timezone": "Europe/Prague",
  "packageRules": [
    {
      "dependencyDashboardApproval": true,
      "matchPackageNames": [
        "/actions.*/"
      ]
    }
  ],
  "ignorePaths": ["src/functionalTest/gradle-projects/**"]
}
